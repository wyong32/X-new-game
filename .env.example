# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Mode: 'mock' (default) or 'live'
X_DATA_MODE="mock"

# X Bearer Token (needed only when X_DATA_MODE="live")
X_BEARER_TOKEN=""

# Private-app authentication guard password
APP_PASSWORD=""

# Retention and limits
RAW_POST_TEXT_RETENTION_DAYS=14
APP_TIMEZONE="Asia/Jakarta"
MAX_X_REQUESTS_PER_RUN=30
MAX_X_POSTS_PER_RUN=1000
MAX_X_POSTS_PER_QUERY=100
MAX_GEMINI_EXTRACTIONS_PER_RUN=30
GEMINI_EXTRACTION_ENABLED=true

